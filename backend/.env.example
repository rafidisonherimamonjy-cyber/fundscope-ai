# Copiez ce fichier en ".env" puis ajustez les valeurs selon votre environnement.

APP_ENV=development
DEBUG=true

# --- Sécurité ---
SECRET_KEY=change-me-to-a-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_MINUTES=43200

# --- Base de données ---
# Développement rapide (aucune installation requise) :
DATABASE_URL=sqlite:///./fundscope.db
# Production (PostgreSQL) :
# DATABASE_URL=postgresql+psycopg2://fundscope_user:fundscope_pass@localhost:5432/fundscope

# --- CORS ---
# Liste séparée par virgules, ou ["*"] pour tout autoriser en développement
CORS_ORIGINS=["*"]

# --- IA ---
# "mock" pour tester sans clé API, "openai" pour utiliser l'API OpenAI
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Notifications push ---
# "mock" pour journaliser sans envoi réel, "fcm" pour Firebase Cloud Messaging
NOTIFICATION_PROVIDER=mock
FCM_CREDENTIALS_FILE=

# --- Compte admin créé par le script de seed ---
ADMIN_EMAIL=admin@fundscope.ai
ADMIN_PASSWORD=Admin123!
